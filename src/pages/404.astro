---
// 404：风格统一的走失页面
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="404 · 页面走丢了 — School Mate"
  description="这个页面好像被搭子带走了。"
>
  <main id="top">
    <section class="section notfound">
      <div class="container">
        <div class="nf-card">
          <div class="nf-code">404</div>
          <h1>这个页面被搭子带走了</h1>
          <p>你要找的内容可能已经下线，或者链接输错了一个字。</p>
          <div class="nf-actions">
            <a class="btn btn-ink" data-magnetic href="/">回到首页</a>
            <a class="btn btn-sticker" data-magnetic href="/#join">加入内测</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .notfound { min-height: calc(100vh - 72px); display: grid; place-items: center; padding: 80px 0; }
  .nf-card {
    max-width: 620px; margin: 0 auto; text-align: center;
    background: #fff; border: 3px solid var(--ink); border-radius: 34px;
    padding: 46px 32px; box-shadow: var(--shadow-hard-xl);
  }
  .nf-code {
    font-family: var(--font-latin); font-size: clamp(76px, 14vw, 132px); font-weight: 800;
    line-height: 1; color: var(--sun); -webkit-text-stroke: 4px var(--ink);
    text-shadow: 6px 6px 0 var(--tangerine);
    margin-bottom: 8px; animation: nfBob 3.2s ease-in-out infinite;
  }
  @keyframes nfBob { 50% { transform: translateY(-10px) rotate(-3deg); } }
  .nf-card h1 { font-family: var(--font-zh); font-weight: 400; font-size: clamp(22px, 3.4vw, 32px); letter-spacing: 1px; }
  .nf-card p { color: var(--ink-soft); font-weight: 500; margin: 10px 0 26px; }
  .nf-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
</style>
