---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Features from '../components/Features.astro';
import Platforms from '../components/Platforms.astro';
import Advantages from '../components/Advantages.astro';
import Numbers from '../components/Numbers.astro';
import Compare from '../components/Compare.astro';
import Scenes from '../components/Scenes.astro';
import Roadmap from '../components/Roadmap.astro';
import Voices from '../components/Voices.astro';
import Faq from '../components/Faq.astro';
import Join from '../components/Join.astro';
---

<Layout
  title="School Mate · 校园搭子 — 大学生轻交易分享平台"
  description="大学生轻交易 · 分享平台 —— 用校园社交的信任做底座，叠加轻量交易、二手流转与技能分享。"
>
  <main id="top">
    <Hero />
    <About />
    <Features />
    <Platforms />
    <Advantages />
    <Numbers />
    <Compare />
    <Scenes />
    <Roadmap />
    <Voices />
    <Faq />
    <Join />
  </main>
</Layout>
