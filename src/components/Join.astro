---
// CTA：内测申请 + 亮色粒子氛围（表单交互由 Layout 脚本驱动 #joinForm / #joinEmail / #formHint）
import Particles from './Particles.astro';
---
<section class="cta" id="join">
  <div class="container">
    <div class="cta-card">
      <Particles density={13000} link={100} dark />
      <div class="cta-inner">
        <div class="cta-badge">🤝</div>
        <h2>和你的校园搭子，击个掌</h2>
        <p>项目正在孵化中，欢迎有想法、有热情的同学一起共建。</p>
        <form class="join-form" id="joinForm" novalidate>
          <input
            aria-label="邮箱"
            id="joinEmail"
            placeholder="留下你的邮箱，第一时间获取内测"
            type="email"
          />
          <button class="btn btn-sticker" data-magnetic type="submit">申请内测</button>
        </form>
        <p class="form-hint" id="formHint"></p>
        <div class="cta-meta">
          <span>🛡️ 邮箱仅用于内测通知</span>
          <span>·</span>
          <span>🎁 首批用户永久免佣</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding: 62px 0; position: relative; z-index: 2; }
  .cta-card {
    max-width: 820px; margin: 0 auto; text-align: center;
    background: var(--ink); color: var(--cream); border: 3px solid var(--ink);
    border-radius: 34px; box-shadow: var(--shadow-hard-xl);
    position: relative; overflow: hidden;
  }
  .cta-card::before {
    content: ""; position: absolute; width: 260px; height: 260px;
    background: var(--grape); border: 3px solid var(--ink); border-radius: 50%;
    top: -130px; right: -90px; opacity: .85;
  }
  .cta-card::after {
    content: ""; position: absolute; width: 180px; height: 180px;
    background: var(--tangerine); border: 3px solid var(--ink); border-radius: 50%;
    bottom: -100px; left: -60px; opacity: .85;
  }
  .cta-inner { position: relative; z-index: 2; padding: 48px 30px 40px; }
  .cta-badge {
    width: 72px; height: 72px; border-radius: 50%; background: var(--sun);
    border: 3px solid var(--ink); display: grid; place-items: center;
    font-size: 34px; margin: 0 auto 18px;
    box-shadow: 3px 3px 0 rgba(0,0,0,.4);
    animation: badgeFloat 3s ease-in-out infinite;
  }
  @keyframes badgeFloat { 50% { transform: translateY(-8px) rotate(6deg); } }
  .cta-card h2 {
    font-family: var(--font-zh); font-size: clamp(26px, 4vw, 40px);
    font-weight: 400; letter-spacing: 1px;
  }
  .cta-card p { margin: 12px 0 22px; font-weight: 500; color: #d9d4ee; }
  .join-form { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .join-form input {
    padding: 14px 20px; border-radius: 999px; border: 2.5px solid var(--ink);
    min-width: 280px; font-size: 15px; outline: none;
    font-family: var(--font-body); background: #fff; color: var(--ink);
    transition: box-shadow .2s;
  }
  .join-form input:focus { box-shadow: 0 0 0 4px rgba(255, 197, 61, .45); }
  .form-hint { margin-top: 16px; font-size: 14px; font-weight: 700; min-height: 20px; color: inherit; }
  .form-hint.ok { color: var(--sun); }
  .form-hint.err { color: #ffb4a2; }
  .cta-meta {
    display: flex; justify-content: center; gap: 10px; margin-top: 20px;
    font-size: 12.5px; font-weight: 600; color: #b9b2d6; flex-wrap: wrap;
  }

  @media (max-width: 560px) {
    .join-form input { min-width: 100%; }
    .join-form .btn { width: 100%; }
  }
</style>
